@persistence(name='tn_acm_secscp')
@name(label='权限作用域', plural='security_scopes')
security_scope<

  @persistence(name='secscpid')
  @name(label='作用域ID')
  id!!: long,

  @persistence(name='prntid')
  @name(label='父作用域ID')
  parent_id: long,

  @persistence(name='ancs')
  @name(label='祖先节点路径')
  ancestors!: string(500),

  @persistence(name='secscpnm')
  @name(label='作用域名称')
  name!: string(100),

  @persistence(name='secscptyp')
  @name(label='作用域类型')
  type!: enum[GRP:GROUP('集团域'),CMP:COMPANY('公司域'),DIV:DIVISION('事业部域'),DEP:DEPARTMENT('部门域'),TEM:TEAM('项目域'),CST:CUSTOM('自定义域')],

  @persistence(name='ldrusrid')
  @name(label='作用域负责人ID')
  leader_user_id: long,

  @persistence(name='srt')
  @name(label='排序值')
  sort: int,

  @persistence(name='crttm')
  @name(label='创建时间')
  created_time: datetime,

  @persistence(name='updtm')
  @name(label='更新时间')
  updated_time: datetime
>

@persistence(name='tn_acm_rl')
@name(label='角色', plural='roles')
role<

  @persistence(name='rlid')
  @name(label='角色ID')
  id!!: long,

  @persistence(name='rlcd')
  @name(label='角色编码')
  code!: string(50),

  @persistence(name='rlnm')
  @name(label='角色名称')
  name!: string(100),

  @persistence(name='descr')
  @name(label='描述')
  description: string(500),

  @persistence(name='stus')
  @name(label='状态')
  status!: enum[ACT:ACTIVE('启用'),DIS:DISACTIVE('禁用')],

  @persistence(name='crttm')
  @name(label='创建时间')
  created_time: datetime,

  @persistence(name='updtm')
  @name(label='更新时间')
  updated_time: datetime,
  
  @conjunction(object='role_function_permission')
  @name(label='功能', singular='function')
  functions: &function_permission(id)[],
  
  @conjunction(object='role_resource_permission')
  @name(label='资源', singular='resource')
  resources: &resource_permission(id)[]
>

@persistence(name='tn_acm_funcperm')
@name(label='功能权限', plural='function_permissions')
function_permission<

  @persistence(name='permid')
  @name(label='权限ID')
  id!!: long,

  @persistence(name='prntid')
  @name(label='父权限ID')
  parent_id: long,

  @persistence(name='permcd')
  @name(label='权限编码')
  code!: string(100),

  @persistence(name='permnm')
  @name(label='权限名称')
  name!: string(100),

  @persistence(name='permtyp')
  @name(label='权限类型')
  type!: enum[MN:MENU('菜单'),BT:BUTTON('按钮'),AP:API('接口')],

  @persistence(name='pth')
  @name(label='路由接口路径')
  path: string(250),

  @persistence(name='mthd')
  @name(label='HTTP方法')
  method: enum[GET:GET('获取'),POST:POST('新增'),PUT:PUT('修改'),DEL:DELETE('删除'),ALL:ALL('全部')],

  @persistence(name='srt')
  @name(label='排序')
  sort: int,

  @persistence(name='crttm')
  @name(label='创建时间')
  created_time: datetime,

  @persistence(name='updtm')
  @name(label='更新时间')
  updated_time: datetime
>

@persistence(name='tn_acm_resperm')
@name(label='资源权限', plural='resource_permissions')
resource_permission<

  @persistence(name='respermid')
  @name(label='资源权限ID')
  id!!: long,

  @persistence(name='rlid')
  @name(label='角色ID')
  role_id!: long,

  @persistence(name='rescd')
  @name(label='资源编码')
  resource_code!: string(50),

  @persistence(name='scptyp')
  @name(label='范围类型')
  scope_type!: enum[ALL:ALL('全部数据'),OWN:OWNER('仅本人数据'),SCP:CURRENT_SCOPE('当前作用域数据'),SUB:SUB_SCOPE('当前及子作用域数据'),CST:CUSTOM('自定义作用域数据')],

  @persistence(name='crttm')
  @name(label='创建时间')
  created_time: datetime,

  @persistence(name='updtm')
  @name(label='更新时间')
  updated_time: datetime
>

@persistence(name='tv_acm_usrsecscp')
@name(label='用户作用域关联', plural='user_security_scopes')
user_security_scope<

  @persistence(name='usrid')
  @name(label='用户ID')
  user_id!!: long,

  @persistence(name='secscpid')
  @name(label='作用域ID')
  scope_id!!: long,

  @persistence(name='ispri')
  @name(label='是否主作用域')
  is_primary!: enum[Y:YES('是'),N:NO('否')]
>

@persistence(name='tv_acm_usrrl')
@name(label='用户角色关联', plural='user_roles')
user_role<

  @persistence(name='usrid')
  @name(label='用户ID')
  user_id!!: long,

  @persistence(name='rlid')
  @name(label='角色ID')
  role_id!!: long,

  @persistence(name='secscpid')
  @name(label='生效作用域ID')
  scope_id: long
>

@persistence(name='tx_acm_rlfuncperm')
@name(label='角色功能权限关联', plural='role_function_permissions')
role_function_permission<

  @persistence(name='rlid')
  @name(label='角色ID')
  role!!: &role(id),

  @persistence(name='funcpermid')
  @name(label='功能权限ID')
  function_permission!!: &function_permission(id)
>

@persistence(name='tx_acm_rlresperm')
@name(label='资源权限作用域关联', plural='role_resource_permissions')
role_resource_permission<

  @persistence(name='rlid')
  @name(label='角色ID')
  role!!: &role(id),
  
  @persistence(name='respermid')
  @name(label='资源权限ID')
  resource_permission!!: &resource_permission(id)
>
